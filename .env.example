# Local development settings for the Compose stack (Docker or Podman).
# Copy to .env (git-ignored): cp .env.example .env
#
# The passwords below are placeholders for a local machine only. Never reuse them anywhere else.
# Keep passwords to letters, digits, "-" and "_": they are placed inside connection URIs.

# --- Ports on the host (change one if it is already taken) ---
AIRFLOW_PORT=8080
SUPERSET_PORT=8088
CLICKHOUSE_HTTP_PORT=8123
POSTGRES_PORT=5432

# --- Metadata database (Postgres) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
AIRFLOW_DB_PASSWORD=airflow
SUPERSET_DB_PASSWORD=superset

# --- Warehouse (ClickHouse) ---
# Loading/transforming account: owns bronze, silver and gold.
CLICKHOUSE_USER=pipeline
CLICKHOUSE_PASSWORD=pipeline
# Read-only account used by Superset: SELECT on gold only.
CLICKHOUSE_READER_USER=superset_reader
CLICKHOUSE_READER_PASSWORD=superset_reader

# --- Orchestrator (Airflow) ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Linux only: so files Airflow writes to ingestion/output/, airflow/logs/ and dbt/ belong to you.
# - Docker Engine: set to the output of `id -u`.
# - Rootless Podman: set to `0` (`make up` sets this automatically when unset).
# Not needed on macOS or Windows.
# AIRFLOW_UID=50000

# --- Dashboards (Superset) ---
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
# Session signing key; any long random string.
SUPERSET_SECRET_KEY=change-me-local-only
